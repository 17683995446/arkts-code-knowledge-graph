{
  "name": "arkts-code-knowledge-graph",
  "version": "4.1.0",
  "description": "ArkTS 千万级代码知识图谱系统 - 企业级代码分析和可视化平台",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "arkts-graph": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "vitest run tests/integration/",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check src tests scripts",
    "lint:fix": "biome check --apply src tests scripts",
    "format": "biome format --write src tests scripts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .arkts-code-graph",
    "prepublishOnly": "npm run build",
    "docs": "typedoc --out docs src/index.ts",
    "benchmark": "tsx scripts/performance-benchmark.ts",
    "analyze": "tsx scripts/real-project-system-test.ts",
    "viz": "npm run dev --prefix web",
    "api": "tsx server/api-server.ts",
    "start": "concurrently \"npm run api\" \"npm run viz\""
  },
  "keywords": [
    "arkts",
    "typescript",
    "javascript",
    "knowledge-graph",
    "code-analysis",
    "code-visualization",
    "static-analysis",
    "ast",
    "graph"
  ],
  "author": "ArkTS Knowledge Graph Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/example/arkts-code-knowledge-graph"
  },
  "bugs": {
    "url": "https://github.com/example/arkts-code-knowledge-graph/issues"
  },
  "homepage": "https://github.com/example/arkts-code-knowledge-graph#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "devDependencies": {
    "@biomejs/biome": "^1.8.0",
    "@types/cors": "^2.8.17",
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^1.6.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.38",
    "rimraf": "^5.0.7",
    "tailwindcss": "^3.4.4",
    "tsup": "^8.1.0",
    "tsx": "^4.11.0",
    "typedoc": "^0.25.13",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@babel/parser": "^7.24.5",
    "@babel/traverse": "^7.24.5",
    "@babel/types": "^7.24.5",
    "@commander-js/extra-typings": "^12.1.0",
    "@inquirer/prompts": "^5.0.4",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "clsx": "^2.1.1",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "cosmiconfig": "^9.0.0",
    "d3": "^7.9.0",
    "express": "^4.19.2",
    "glob": "^10.4.1",
    "graphology": "^0.25.4",
    "graphology-communities-louvain": "^2.0.1",
    "graphology-generators": "^0.11.2",
    "graphology-layout": "^0.6.1",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-metrics": "^2.1.0",
    "graphology-operators": "^1.6.0",
    "graphology-shortest-path": "^2.0.2",
    "graphology-types": "^0.24.7",
    "lucide-react": "^0.394.0",
    "minimatch": "^9.0.4",
    "nanoid": "^5.0.7",
    "node-cache": "^5.1.2",
    "ora": "^8.0.1",
    "pino": "^9.14.0",
    "pino-pretty": "^11.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.3.0",
    "ts-morph": "^21.0.1",
    "vectra": "^0.6.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.2"
  }
}
